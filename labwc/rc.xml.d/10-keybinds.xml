  <keyboard>
    <default />

    <!-- Power Menu (W-S-e, W-Escape) -->
    <keybind key="W-S-e">
      <action name="Execute" command="~/.config/labwc/scripts/powermenu.sh" />
    </keybind>
    <keybind key="W-Escape">
      <action name="Execute" command="~/.config/labwc/scripts/powermenu.sh" />
    </keybind>

    <!-- Application Launcher (W-space, W-d) -->
    <keybind key="W-space">
      <action name="Execute" command="fuzzel" />
    </keybind>
    <keybind key="W-d">
      <action name="Execute" command="fuzzel" />
    </keybind>

    <!-- Clipboard Manager (W-v: history, W-S-v: clear, W-C-v: delete) -->
    <keybind key="W-v">
      <action name="Execute" command="~/.config/labwc/scripts/clipboard.sh" />
    </keybind>
    <keybind key="W-S-v">
      <action name="Execute" command="~/.config/labwc/scripts/clipboard.sh --clear" />
    </keybind>
    <keybind key="W-C-v">
      <action name="Execute" command="~/.config/labwc/scripts/clipboard.sh --delete" />
    </keybind>

    <!-- Terminal -->
    <keybind key="W-Return">
      <action name="Execute" command='footclient' />
    </keybind>

    <!-- Window Management -->
    <keybind key="W-q">
      <action name="Close" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-f">
      <action name="ToggleFullscreen" />
    </keybind>
    <keybind key="W-m">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>

    <!-- Window Snapping (Arrows & Vim keys) -->
    <keybind key="W-Left">
      <action name="ToggleSnapToEdge" direction="left" combine="yes" />
    </keybind>
    <keybind key="W-Right">
      <action name="ToggleSnapToEdge" direction="right" combine="yes" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleSnapToEdge" direction="up" combine="yes" />
    </keybind>
    <keybind key="W-Down">
      <action name="ToggleSnapToEdge" direction="down" combine="yes" />
    </keybind>
    <keybind key="W-h">
      <action name="ToggleSnapToEdge" direction="left" combine="yes" />
    </keybind>
    <keybind key="W-l">
      <action name="ToggleSnapToEdge" direction="right" combine="yes" />
    </keybind>
    <keybind key="W-k">
      <action name="ToggleSnapToEdge" direction="up" combine="yes" />
    </keybind>
    <keybind key="W-j">
      <action name="ToggleSnapToEdge" direction="down" combine="yes" />
    </keybind>

    <!-- Multi-Monitor Output Management -->
    <!-- Move active window to other monitor (Super+Shift+Left/Right or h/l) -->
    <keybind key="W-S-Left"><action name="MoveToOutput" direction="left" wrap="yes" /></keybind>
    <keybind key="W-S-Right"><action name="MoveToOutput" direction="right" wrap="yes" /></keybind>
    <keybind key="W-S-h"><action name="MoveToOutput" direction="left" wrap="yes" /></keybind>
    <keybind key="W-S-l"><action name="MoveToOutput" direction="right" wrap="yes" /></keybind>

    <!-- Focus other monitor (Super+Ctrl+Left/Right or h/l) -->
    <keybind key="W-C-Left"><action name="FocusOutput" direction="left" wrap="yes" /></keybind>
    <keybind key="W-C-Right"><action name="FocusOutput" direction="right" wrap="yes" /></keybind>
    <keybind key="W-C-h"><action name="FocusOutput" direction="left" wrap="yes" /></keybind>
    <keybind key="W-C-l"><action name="FocusOutput" direction="right" wrap="yes" /></keybind>

    <!-- Pin Window / Sticky (Omnipresent - keeps window visible across all workspaces) -->
    <keybind key="W-p"><action name="ToggleOmnipresent" /></keybind>
    <keybind key="W-s"><action name="ToggleOmnipresent" /></keybind>

    <!-- Workspace Switching (1 - 10) -->
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-5"><action name="GoToDesktop" to="5" /></keybind>
    <keybind key="W-6"><action name="GoToDesktop" to="6" /></keybind>
    <keybind key="W-7"><action name="GoToDesktop" to="7" /></keybind>
    <keybind key="W-8"><action name="GoToDesktop" to="8" /></keybind>
    <keybind key="W-9"><action name="GoToDesktop" to="9" /></keybind>
    <keybind key="W-0"><action name="GoToDesktop" to="10" /></keybind>

    <!-- Send Window to Workspace (1 - 10) -->
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" follow="yes" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" follow="yes" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" follow="yes" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" follow="yes" /></keybind>
    <keybind key="W-S-5"><action name="SendToDesktop" to="5" follow="yes" /></keybind>
    <keybind key="W-S-6"><action name="SendToDesktop" to="6" follow="yes" /></keybind>
    <keybind key="W-S-7"><action name="SendToDesktop" to="7" follow="yes" /></keybind>
    <keybind key="W-S-8"><action name="SendToDesktop" to="8" follow="yes" /></keybind>
    <keybind key="W-S-9"><action name="SendToDesktop" to="9" follow="yes" /></keybind>
    <keybind key="W-S-0"><action name="SendToDesktop" to="10" follow="yes" /></keybind>

    <!-- Workspace Navigation (Cycle & History) -->
    <keybind key="W-bracketleft"><action name="GoToDesktop" to="left" wrap="yes" /></keybind>
    <keybind key="W-bracketright"><action name="GoToDesktop" to="right" wrap="yes" /></keybind>
    <keybind key="W-Tab"><action name="GoToDesktop" to="last" wrap="yes" /></keybind>

    <!-- Utilities -->
    <keybind key="W-S-x"><action name="Execute" command="~/.config/labwc/scripts/ocr.sh" /></keybind>
    <keybind key="W-S-r"><action name="Execute" command="~/.config/labwc/scripts/screen-record.sh" /></keybind>
    <keybind key="A-W-r"><action name="Execute" command="~/.config/labwc/scripts/screen-record.sh --region" /></keybind>
    <keybind key="W-S-n"><action name="Execute" command="~/.config/labwc/scripts/nightlight.sh" /></keybind>

    <!-- Media & OSD Pipeline -->
    <keybind key="XF86AudioPlay"><action name="Execute" command="playerctl play-pause" /></keybind>
    <keybind key="XF86AudioNext"><action name="Execute" command="playerctl next" /></keybind>
    <keybind key="XF86AudioPrev"><action name="Execute" command="playerctl previous" /></keybind>
    <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="~/.config/labwc/scripts/osd-volume.sh up" /></keybind>
    <keybind key="XF86AudioLowerVolume"><action name="Execute" command="~/.config/labwc/scripts/osd-volume.sh down" /></keybind>
    <keybind key="XF86AudioMute"><action name="Execute" command="~/.config/labwc/scripts/osd-volume.sh mute" /></keybind>
    <keybind key="XF86AudioMicMute"><action name="Execute" command="~/.config/labwc/scripts/osd-volume.sh mic-mute" /></keybind>
    <keybind key="XF86MonBrightnessUp"><action name="Execute" command="~/.config/labwc/scripts/osd-brightness.sh up" /></keybind>
    <keybind key="XF86MonBrightnessDown"><action name="Execute" command="~/.config/labwc/scripts/osd-brightness.sh down" /></keybind>

    <!-- Screenshots -->
    <keybind key="Print">
      <action name="Execute"><command>sh -c 'grim - | wl-copy'</command></action>
    </keybind>
    <keybind key="S-Print">
      <action name="Execute"><command>sh -c 'grim -g "$(slurp)" - | wl-copy'</command></action>
    </keybind>
    <keybind key="C-Print">
      <action name="Execute"><command>sh -c 'mkdir -p ~/Pictures/Screenshots &amp;&amp; grim -g "$(slurp)" ~/Pictures/Screenshots/$(date +"%Y-%m-%d_%H-%M-%S").png'</command></action>
    </keybind>
  </keyboard>
