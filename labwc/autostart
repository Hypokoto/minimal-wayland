#!/usr/bin/env bash
# Labwc Autostart (Systemd-driven)

# 1. Terminal server for instant `footclient` launches
if command -v foot >/dev/null 2>&1; then
	foot --server &
fi

# 2. Export environment to systemd and dbus
dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
systemctl --user import-environment WAYLAND_DISPLAY XDG_CURRENT_DESKTOP

# 3. Start the minimal wayland target
systemctl --user start minimal-wayland.target

# 4. Explicit Teardown Hook
# Wait for the parent compositor (labwc) to exit, then stop the session target cleanly.
(
	tail --pid=$PPID -f /dev/null
	systemctl --user stop minimal-wayland.target
) &
