# Labwc Autostart
# Clean, deterministic, defensive startup pipeline

# 1. Terminal server for instant `footclient` launches
if command -v foot >/dev/null 2>&1; then
	foot --server &
fi

# 2. Notifications
if command -v mako >/dev/null 2>&1; then
	mako &
fi

# 3. Dynamic display & monitor hotplugging
if command -v kanshi >/dev/null 2>&1; then
	kanshi &
fi

# 4. Wayland in-memory clipboard daemon (minclip)
if command -v minclip >/dev/null 2>&1; then
	minclip --daemon &
elif command -v wl-paste >/dev/null 2>&1 && command -v cliphist >/dev/null 2>&1; then
	wl-paste --type text --watch cliphist store &
	wl-paste --type image --watch cliphist store &
fi

# 5. Polkit authentication agent
if command -v lxqt-policykit-agent >/dev/null 2>&1; then
	lxqt-policykit-agent &
fi

# 6. Wayland wallpaper daemon (fallback if systemd user service inactive)
if ! pgrep -x awww-daemon >/dev/null 2>&1 && ! systemctl --user is-active --quiet minimal-wallpaper.service 2>/dev/null; then
	if command -v awww-daemon >/dev/null 2>&1; then
		awww-daemon &
	elif command -v swww-daemon >/dev/null 2>&1; then
		swww-daemon &
	fi
fi

# 7. Idle & lockscreen management via swayidle
if command -v swayidle >/dev/null 2>&1; then
	swayidle -w &
fi

# 8. Event-driven native battery monitor daemon
if command -v minbat >/dev/null 2>&1; then
	minbat &
fi

# 9. Wayland layer-shell OSD overlay daemon
if command -v minosd >/dev/null 2>&1; then
	minosd --daemon &
fi
