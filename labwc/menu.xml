<?xml version="1.0" encoding="UTF-8"?>
<openbox_menu>
  <menu id="root-menu" label="Minimal Labwc">
    <item label="Terminal (Foot)">
      <action name="Execute" command='sh -c "footclient || foot"' />
    </item>
    <item label="Launcher (Fuzzel)">
      <action name="Execute" command="fuzzel" />
    </item>
    <item label="Clipboard (History)">
      <action name="Execute" command="~/.config/labwc/scripts/clipboard.sh" />
    </item>
    <item label="File Manager (Yazi)">
      <action name="Execute" command="foot -e yazi" />
    </item>
    <separator />
    <item label="Reload Config">
      <action name="Reconfigure" />
    </item>
    <item label="Power Menu">
      <action name="Execute" command="~/.config/labwc/scripts/powermenu.sh" />
    </item>
    <item label="Exit Labwc">
      <action name="Exit" />
    </item>
  </menu>
</openbox_menu>
