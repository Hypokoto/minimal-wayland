{
    "label" : "lock",
    "action" : "swaylock -f -C ~/.config/swaylock/config 2>/dev/null || swaylock -f",
    "text" : "Lock",
    "keybind" : "l"
}
{
    "label" : "logout",
    "action" : "echo -e 'No\nYes' | fuzzel --dmenu -p 'Logout? ' -l 2 | grep -q '^Yes$' && (loginctl terminate-session ${XDG_SESSION_ID:-} || labwc --exit || pkill -u $USER -x labwc)",
    "text" : "Logout",
    "keybind" : "e"
}
{
    "label" : "suspend",
    "action" : "systemctl suspend",
    "text" : "Suspend",
    "keybind" : "u"
}
{
    "label" : "reboot",
    "action" : "echo -e 'No\nYes' | fuzzel --dmenu -p 'Reboot? ' -l 2 | grep -q '^Yes$' && systemctl reboot",
    "text" : "Reboot",
    "keybind" : "r"
}
{
    "label" : "shutdown",
    "action" : "echo -e 'No\nYes' | fuzzel --dmenu -p 'Shutdown? ' -l 2 | grep -q '^Yes$' && systemctl poweroff",
    "text" : "Shutdown",
    "keybind" : "s"
}
